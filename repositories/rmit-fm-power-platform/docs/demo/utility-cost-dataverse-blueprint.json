  "relationships": [
    "fm_campus 1:N fm_building",
    "fm_building 1:N fm_meter",
    "fm_ingestionrun 1:N fm_ingestionfile",
    "fm_ingestionrun 1:N fm_bronze_utilityreadingraw",
    "fm_ingestionfile 1:N fm_bronze_utilityreadingraw",
    "fm_bronze_utilityreadingraw 1:0..1 fm_silver_utilityreading",
    "fm_bronze_utilityreadingraw 1:N fm_dataqualityissue",
    "fm_bronze_utilityreadingraw 1:N fm_utilityreadingquarantine",
    "fm_meter 1:N fm_silver_utilityreading",
    "fm_meter 1:N fm_gold_utilitydailycost",
    "fm_silver_utilitytariff 1:N fm_gold_utilitydailycost",
    "fm_ingestionrun 1:N fm_promotionrequest"
  ],
  "serverExtensions": [
    {
      "name": "BronzeRawWriteGuard",
      "messages": ["Create", "Update", "Delete"],
      "responsibility": "Validate required lineage and permitted writer on Create; reject Update/Delete",
      "nonResponsibility": "No batch parsing or Bronze-to-Silver transformation"
    },
    {
      "name": "fm_RequestUtilityPromotion",
      "type": "Custom API",
      "inputs": ["ingestionRunId", "mappingVersion"],
      "outputs": ["promotionRequestId", "status"],
      "responsibility": "Validate committed run and create one idempotent promotion request",
      "nonResponsibility": "No synchronous bulk transformation"
    }
  ],
  "unresolved": [
    "Approved Publisher prefix and physical logical names",
    "Ownership type, auditing, retention, capacity and indexing per table",
    "Currency versus decimal behavior for multi-currency cost",
    "Production security roles and business-unit depth",
    "Correction/reload and meter-reset authorization path"
  ]
}
