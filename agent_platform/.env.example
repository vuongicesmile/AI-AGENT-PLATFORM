# Local persistent data directory. Defaults to the operating system user data directory.
AI_AGENT_DATA_DIR=C:\Users\YOUR_NAME\AppData\Local\AI-Agent-Platform

# Optional. Separate multiple approved roots with ';' on Windows or ':' on Linux/macOS.
AI_AGENT_ALLOWED_ROOTS=C:\source

# Gemini Notebook Enterprise only. Personal accounts use the export command instead.
GEMINI_NOTEBOOK_PROJECT_NUMBER=123456789012
GEMINI_NOTEBOOK_ID=your-notebook-id
GEMINI_NOTEBOOK_LOCATION=global
GEMINI_NOTEBOOK_ENDPOINT_LOCATION=global
